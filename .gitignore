# Generated corpus and index (keep folder placeholders)
#
# data/chroma/ and .hfcache/ are COMMITTED so deployed hosts with an ephemeral
# filesystem (Render free, Streamlit Community Cloud) can serve the built vector
# index and the offline MiniLM model cache without a build step at runtime.
data/raw/html/*
!data/raw/html/.gitkeep
data/raw/documents/*
!data/raw/documents/.gitkeep
data/chunks/*
!data/chunks/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
!data/**/.gitkeep
